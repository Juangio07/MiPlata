# Supabase project URL, for example: https://your-project.supabase.co
SUPABASE_URL=

# Public client key. It is safe to expose only in the browser-facing config.
SUPABASE_PUBLISHABLE_KEY=

# Server-only key. Never commit a real value or expose it to the frontend.
SUPABASE_SECRET_KEY=

# Optional comma-separated origins allowed to call the local Flask API.
CORS_ORIGINS=http://127.0.0.1:5000,http://localhost:5000,https://miplatabyf.netlify.app
